<Project>
  <PropertyGroup>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="StyleCop.Analyzers" Version="1.2.0-beta.556" PrivateAssets="all" IncludeAssets="analyzers" />
    <PackageReference Include="Roslynator.Analyzers" Version="4.8.0" PrivateAssets="all" IncludeAssets="analyzers" />
    <PackageReference Include="Meziantou.Analyzer" Version="2.0.0" PrivateAssets="all" IncludeAssets="analyzers" />
  </ItemGroup>
</Project>
